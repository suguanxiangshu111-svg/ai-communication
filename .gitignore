# ============================================================
#  AI 智能伴侣 —— .gitignore
#  最要紧的一条：sessions/ 里是你真实的情侣对话记录，
#  绝对不要提交到 GitHub！
# ============================================================

# ---------- 🔒 隐私数据（务必忽略）----------
sessions/
*.session.json
*.backup.json

# ---------- 🔑 密钥 / 环境变量 ----------
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml
*_api_key*
api_key*
*_secret*
*.pem

# ---------- 🐍 Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

# ---------- 📦 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- 🧪 测试临时产物 ----------
_tests/_workdir/

# ---------- 🖥️ 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- 📊 日志 ----------
*.log
